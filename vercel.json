{
  "version": 2,
  "functions": {
    "api/stripe-webhook.js": {
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app.html",
      "destination": "/app.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/process-scheduled-emails",
      "schedule": "0 9 * * *"
    }
  ]
}