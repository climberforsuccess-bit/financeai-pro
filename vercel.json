{
  "version": 2,
  "functions": {
    "api/stripe-webhook.js": {
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/((?!\\.(?:html|css|js|json|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)).)*$",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/process-scheduled-emails",
      "schedule": "0 9 * * *"
    }
  ]
}